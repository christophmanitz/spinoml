      }
    },
    {
      "id": "ren",
      "dataType": "RenameColumns",
      "params": {
        "mapping": "old:new"
      }
    },
    {
      "id": "out",
      "dataType": "WriteDataset",
      "params": {
        "out_path": "datasets/processed.csv",
        "format": "csv"
      }
    }
  ],
  "edges": [
    {
      "source": "src",
      "target": "cs"
    },
    {
