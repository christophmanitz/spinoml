{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "spinoml",
  "version": "0.1.0",
  "identifier": "dev.spinoml.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SpinoML",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "worker-src": ["'self'", "blob:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://127.0.0.1:7421",
          "http://127.0.0.1:7422",
          "http://127.0.0.1:7424"
        ],
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'self'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Drag-and-drop PyTorch architecture builder",
    "longDescription": "SpinoML lets you build nn.Module architectures by dragging layers onto a canvas, see live shape inference from PyTorch, and have Claude edit the graph through tools.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar-torch": "sidecar-torch",
      "../sidecar-llm": "sidecar-llm"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
